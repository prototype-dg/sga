<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bioc="http://bpmn.io/schema/bpmn/bioc" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://flowable.org/sga">
  <process id="OCP_case" name="Octroi de Credit (migré depuis Jira)">
    <startEvent id="start" name="Création dossier (APPLI)"/>
    <userTask id="task_5" name="Attente AXA" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente AXA - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting AXA (insurance) - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_8" name="Demande en étude" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande en étude - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application under review - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_9" name="Demande refusée" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande refusée - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application refused - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_10" name="Attente décision" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente décision - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting decision - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_11" name="Demande initiée" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande initiée - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application initiated - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_12" name="Demande rejetée" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande rejetée - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application rejected - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_13" name="Attente infos Supp Décisionnaire" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente infos Supp Décisionnaire - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional info - Decision Maker - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_14" name="Etude en cours" flowable:candidateGroups="SGA-Etude"><documentation>FR: Etude en cours - etape manuelle (agent), groupe SGA-Etude, traitement dans Jira. EN: Review in progress - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_15" name="Montage à refaire" flowable:candidateGroups="SGA-Montage"><documentation>FR: Montage à refaire - etape manuelle (agent), groupe SGA-Montage, traitement dans Jira. EN: Restructuring required - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_16" name="Attente infos supp BO" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente infos supp BO - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional info - Back Office - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_17" name="Garanties à recueillir" flowable:candidateGroups="SGA-Garanties"><documentation>FR: Garanties à recueillir - etape manuelle (agent), groupe SGA-Garanties, traitement dans Jira. EN: Collaterals to be collected - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_18" name="Garanties reçues" flowable:candidateGroups="SGA-Garanties"><documentation>FR: Garanties reçues - etape manuelle (agent), groupe SGA-Garanties, traitement dans Jira. EN: Collaterals received - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_19" name="Attente complément" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente complément - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional documents - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_20" name="Dossier Constitué" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier Constitué - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case file assembled - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_21" name="garantie pré-validée" flowable:candidateGroups="SGA-garantie"><documentation>FR: garantie pré-validée - etape manuelle (agent), groupe SGA-garantie, traitement dans Jira. EN: Collateral pre-validated - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_22" name="Attente info supp garantie" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente info supp garantie - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional collateral info - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_23" name="Dossier décaissé" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier décaissé - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case disbursed - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_25" name="Garantie validée" flowable:candidateGroups="SGA-Garantie"><documentation>FR: Garantie validée - etape manuelle (agent), groupe SGA-Garantie, traitement dans Jira. EN: Collateral validated - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_26" name="Demande Reçue" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande Reçue - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application received - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_27" name="Dérogation demandée" flowable:candidateGroups="SGA-Dérogation"><documentation>FR: Dérogation demandée - etape manuelle (agent), groupe SGA-Dérogation, traitement dans Jira. EN: Waiver requested - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_28" name="Attente Info Supp DR" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente Info Supp DR - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional info - Regional Directorate - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_29" name="Attente Info Supp RUC" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente Info Supp RUC - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting additional info - RUC - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_30" name="Annulé" flowable:candidateGroups="SGA-Annulé"><documentation>FR: Annulé - etape manuelle (agent), groupe SGA-Annulé, traitement dans Jira. EN: Cancelled - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_31" name="Dossier à décaisser" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier à décaisser - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case to be disbursed - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_33" name="En cours d&#x27;annulation" flowable:candidateGroups="SGA-En"><documentation>FR: En cours d&#x27;annulation - etape manuelle (agent), groupe SGA-En, traitement dans Jira. EN: Cancellation in progress - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_34" name="Attente info sup POS/APPLI" flowable:candidateGroups="SGA-Attente"><documentation>FR: Attente info sup POS/APPLI - etape manuelle (agent), groupe SGA-Attente, traitement dans Jira. EN: Awaiting info from POS/APPLI - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_35" name="Demande incomplète" flowable:candidateGroups="SGA-Demande"><documentation>FR: Demande incomplète - etape manuelle (agent), groupe SGA-Demande, traitement dans Jira. EN: Application incomplete - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_36" name="Dossier à contrôler" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier à contrôler - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case to be controlled - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_37" name="Contrôle en cours" flowable:candidateGroups="SGA-Contrôle"><documentation>FR: Contrôle en cours - etape manuelle (agent), groupe SGA-Contrôle, traitement dans Jira. EN: Control in progress - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_38" name="Contrôle validé" flowable:candidateGroups="SGA-Contrôle"><documentation>FR: Contrôle validé - etape manuelle (agent), groupe SGA-Contrôle, traitement dans Jira. EN: Control validated - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_39" name="Dossier à compléter" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier à compléter - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case to be completed - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_40" name="Dossier soldé" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier soldé - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case settled - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_41" name="Dossier décaissé partiellement" flowable:candidateGroups="SGA-Dossier"><documentation>FR: Dossier décaissé partiellement - etape manuelle (agent), groupe SGA-Dossier, traitement dans Jira. EN: Case partially disbursed - manual step (agent), handled in Jira.</documentation></userTask>
    <userTask id="task_42" name="En attente de signature" flowable:candidateGroups="SGA-En"><documentation>FR: En attente de signature - etape manuelle (agent), groupe SGA-En, traitement dans Jira. EN: Awaiting signature - manual step (agent), handled in Jira.</documentation></userTask>
    <serviceTask id="appli_0" name="[APPLI] - Soumettre pour décision" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Soumettre pour décision - AUTOMATISATION : appel systeme EXTERNE via bridge appliBridge (middleware, WSO2/REST vers le SI partenaire). EN: [APPLI] - Submit for decision - EXTERNAL system call (WSO2/REST to partner SI).</documentation></serviceTask>
    <serviceTask id="appli_1" name="[APPLI] - Demande refusée" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Demande refusée - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Application refused - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_2" name="[APPLI] - Décision" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Décision - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Decision - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_3" name="[APPLI] - Défavorable" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Défavorable - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Unfavourable outcome - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_4" name="[APPLI] - Attente décision" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Attente décision - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Awaiting decision - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_5" name="[APPLI] - Constituer dossier - Demander garanties" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Constituer dossier - Demander garanties - AUTOMATISATION : appel systeme EXTERNE via bridge appliBridge (middleware, WSO2/REST vers le SI partenaire). EN: [APPLI] - Assemble case - request collaterals - EXTERNAL system call (WSO2/REST to partner SI).</documentation></serviceTask>
    <serviceTask id="appli_6" name="[APPLI] - Garanties reçues" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Garanties reçues - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Collaterals received - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_7" name="[APPLI] - Décaisser dossier" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Décaisser dossier - AUTOMATISATION : appel systeme EXTERNE via bridge appliBridge (middleware, WSO2/REST vers le SI partenaire). EN: [APPLI] - Disburse case - EXTERNAL system call (WSO2/REST to partner SI).</documentation></serviceTask>
    <serviceTask id="appli_8" name="[APPLI] - Compléter la demande" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Compléter la demande - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Complete the application - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_9" name="[APPLI] - Test TNR APPLI" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Test TNR APPLI - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - APPLI non-regression test - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_10" name="[APPLI] - Garanties à recueillir" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Garanties à recueillir - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Collaterals to be collected - INTERNAL system operation.</documentation></serviceTask>
    <serviceTask id="appli_11" name="[APPLI] - Auto Fournir infos supp APPLI/POS" flowable:delegateExpression="${appliBridge}"><documentation>FR: [APPLI] - Auto Fournir infos supp APPLI/POS - AUTOMATISATION : operation systeme INTERNE via bridge appliBridge (middleware, SI SGA). EN: [APPLI] - Auto-provide additional APPLI/POS info - INTERNAL system operation.</documentation></serviceTask>
    <endEvent id="end" name="Fin de parcours"/>
